# Copy this file to .env and fill in what you need. Docker Compose reads .env automatically.
# Everything here can also be entered on the setup screen, except the model and watcher settings.

PR_EXPLAINER_GITHUB_TOKEN=
PR_EXPLAINER_LITELLM_API_KEY=
PR_EXPLAINER_LITELLM_BASE_URL=https://your-litellm-gateway.example.com

# Model ids as your LiteLLM gateway names them. These are the defaults.
# PR_EXPLAINER_FAST_MODEL=deepseek-chat
# PR_EXPLAINER_STRONG_MODEL=claude-opus-4-5
# Extra JSON merged into every request to the strong model, for example routing tags.
# PR_EXPLAINER_STRONG_MODEL_BODY={}

# Review-request watcher (turn it on with PRX_WATCH=1). All optional.
# PRX_ORG=my-org
# PRX_TEAMS=my-team
# PRX_EXTRA_TEAMMATES=login1,login2
# PRX_EXCLUDED_TEAMMATES=login3
# PRX_IGNORED_REPOS=my-org/some-repo
